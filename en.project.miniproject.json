column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Our next goal is to plot the translation of a property and see whether\nwe can observe any translation pattern. Please copy the code below and\ncreate new cells for testing with different properties and plot the\nresults. In this plot, we plot the time on the x-axis and translation\ntype on the y-axis.","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"ehWj7QmPs4"}],"key":"lf6kj7DI4i"},{"type":"code","lang":"","value":"import matplotlib \nimport  matplotlib.pyplot as plot \nfrom  dateutil import parser \nimport  numpy as np  \nptranslation  = dataframe.loc[(dataframe[\"property\"]==\"P856\")]  \nx  = [] \ny  = [] \nz  = [] \nfor  i in range(0, len(ptranslation['timestamp'])):\n    #parsing the date in string and converting it to datetime\n    try:\n        value = parser.parse(ptranslation['timestamp'].iloc[i])\n        x.append(value)\n    except Exception:\n        continue\n    y.append(ptranslation['type'].iloc[i])\n    z.append(ptranslation['language'].iloc[i])\n    \n#creating  a plot\nplot.rcParams[\"figure.figsize\"]  = (25, 9) \ncolors  = matplotlib.cm.rainbow(np.linspace(0, 1, 3))\ntcolors  = {'label': colors[0],\n      'description':colors[1],\n      'alias':colors[2]\n     }\ncs  = [tcolors[i] for i in y]  \nfig,  ax = plot.subplots() \nax.scatter(x, y, s=30, color=cs)  \n\nplot.xlabel(\"Time\") \nplot.ylabel(\"Translation type\")  \n\n#annotating  the points \nfor i, txt in enumerate(z):\n   ax.annotate(txt, (x[i], y[i]))\n\nfig.show()             ","position":{"start":{"line":94,"column":1},"end":{"line":132,"column":1}},"key":"N6ZMXTY7z0"},{"type":"paragraph","position":{"start":{"line":134,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"Now, we plot another graph, this time, language on the y-axis and time\non the x-axis.","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"AAvUK6WoS9"}],"key":"PsMKcAnuHx"},{"type":"code","lang":"","value":"import matplotlib \nimport matplotlib.pyplot as plot \nfrom dateutil import parser \nimport numpy as np  \n\nptranslation = dataframe.loc[(dataframe[\"property\"]==\"P279\")]  \nx = [] \ny = [] \nz = [] \n\nfor i in range(0, len(ptranslation['timestamp'])):\n    try:\n      #parsing the date in string and converting it to datetime\n      value = parser.parse(ptranslation['timestamp'].iloc[i])\n      x.append(value)\n    except Exception:\n      continue\n    y.append(ptranslation['type'].iloc[i])\n    z.append(ptranslation['language'].iloc[i])  \n\n#creating a plot \ncolors = matplotlib.cm.rainbow(np.linspace(0, 1, 3)) \ntcolors = {'label': colors[0],\n               'description':colors[1],\n               'alias':colors[2]\n            } \n\ncs = [tcolors[i] for i in y]   \n\nplot.rcParams[\"figure.figsize\"] = (25, 25)  \nfig, ax = plot.subplots() \nax.scatter(x, z, s=50, color=cs)   \n\nplot.xlabel(\"Time\") \nplot.ylabel(\"Language\")  \n\n# saving the plot in a file \nplot.savefig('translation.png') \nfig.show()             ","position":{"start":{"line":137,"column":1},"end":{"line":177,"column":1}},"key":"QkEVG8aoxV"},{"type":"paragraph","position":{"start":{"line":179,"column":1},"end":{"line":183,"column":1}},"children":[{"type":"text","value":"Following are three plots concerning properties: P31, P279 and P856\nrespectively. What are your observations on the values on the y-axis?\nPlease note them as comments on the notebook. You can also see that some\ntranslations can be even made in a single edit. Please check a column of\nred lines in the first figure (P31).","position":{"start":{"line":179,"column":1},"end":{"line":179,"column":1}},"key":"ikTiot1hex"}],"key":"AFQwZjV7yz"},{"type":"image","url":"/IA-DeepLearning/build/p31-bca2e7f8a2cd4637d6525ecfee5074ca.png","alt":"Translation plot of property P31","position":{"start":{"line":185,"column":1},"end":{"line":185,"column":1}},"key":"JGYbzvaS0F","urlSource":"p31.png"},{"type":"image","url":"/IA-DeepLearning/build/p279-cf64858d64d04a7bc2173cd0789e9061.png","alt":"Translation plot of property P279","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"pHgjJXwrjM","urlSource":"p279.png"},{"type":"image","url":"/IA-DeepLearning/build/p856-ed16267beefae1f1229a28d3742670be.png","alt":"Translation plot of property P856","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"jutoTVfime","urlSource":"p856.png"},{"type":"paragraph","position":{"start":{"line":191,"column":1},"end":{"line":193,"column":1}},"children":[{"type":"text","value":"In the code given below, we select some languages and see the order of\ntranslation. Copy the code below and plot the graphs for different\nproperties. Please note your observations as comments on the notebook.","position":{"start":{"line":191,"column":1},"end":{"line":191,"column":1}},"key":"VYFJNsZs8V"}],"key":"hwQ0Jm9Jur"},{"type":"code","lang":"","value":"import matplotlib \nimport matplotlib.pyplot as plot \nfrom dateutil import parser \nimport numpy as np  \n\n#list of languages under consideration \nlanglist  = [\"fr\", \"es\", \"en\", \"de\", \"it\", \"pt\", \"ja\"] \nptranslation  = dataframe.loc[(dataframe[\"property\"]==\"P18\") & (dataframe[\"language\"].isin (langlist))] \nprint(ptranslation)  \n\nx= [] \ny= [] \nz= [] \n\nfor i in range(0, len(ptranslation['timestamp'])):\n    try:\n        #parsing the date in string and converting it to datetime\n        value = parser.parse(ptranslation['timestamp'].iloc[i])\n      x.append(value)\n    except Exception:\n      continue\n    y.append(ptranslation['type'].iloc[i])\n    z.append(ptranslation['language'].iloc[i])  \n\n#creating  a plot \ncolors  = matplotlib.cm.rainbow(np.linspace(0, 1, 3)) \ntcolors  = {'label': colors[0],\n               'description':colors[1],\n               'alias':colors[2]\n             } \n\ncs  = [tcolors[i] for i in y]   \nplot.rcParams[\"figure.figsize\"]  = (10, 5)  \nfig,  ax = plot.subplots() \nax.scatter(x,  z, s=50, color=cs)  \n\nplot.savefig('translation.png') \nfig.show()             ","position":{"start":{"line":195,"column":1},"end":{"line":234,"column":1}},"key":"p3SIGTGBRK"},{"type":"heading","depth":2,"position":{"start":{"line":236,"column":1},"end":{"line":236,"column":1}},"children":[{"type":"text","value":"Exercise 1.2","position":{"start":{"line":236,"column":1},"end":{"line":236,"column":1}},"key":"KoZtFD7fNc"}],"identifier":"exercise-1-2","label":"Exercise 1.2","html_id":"exercise-1-2","implicit":true,"key":"FgqCSJDezL"},{"type":"paragraph","position":{"start":{"line":238,"column":1},"end":{"line":240,"column":1}},"children":[{"type":"text","value":"We used plotting techniques to manually detect some patterns of\ntranslation. Now we use other algorithms to see whether groups of\nlanguages are always present together","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"vEmhLOPJXB"}],"key":"MS9bTreznf"},{"type":"paragraph","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"children":[{"type":"text","value":"Before continuing, we need to install the library ","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"St2QtRkcGb"},{"type":"emphasis","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"children":[{"type":"text","value":"mlxtend","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"O3XLr8FcQA"}],"key":"xPnz5dJtH5"},{"type":"text","value":".","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"NT2Ozoqsfk"}],"key":"gwOPGB3y4W"},{"type":"code","lang":"","value":"             !pip install mlxtend               ","position":{"start":{"line":244,"column":1},"end":{"line":246,"column":1}},"key":"uJOLjIaYc3"},{"type":"paragraph","position":{"start":{"line":248,"column":1},"end":{"line":250,"column":1}},"children":[{"type":"text","value":"Next we prepare the language dataset. We will focus on the translation\nof property labels. We create a list of list of available translations\nof labels of all the properties from our dataset","position":{"start":{"line":248,"column":1},"end":{"line":248,"column":1}},"key":"QRUDmf7KBD"}],"key":"zb0BQPzOHK"},{"type":"code","lang":"","value":"#prepare dataset of languages \nlanguageorder = [] \nlabeldataframe = dataframe.loc[(dataframe[\"type\"] == \"label\")] \ngroups = labeldataframe.groupby([\"property\"]) \n\nfor k, group in groups:\n   languageorder.append(list(groups.get_group((k))[\"language\"])) \nprint(languageorder)","position":{"start":{"line":252,"column":1},"end":{"line":261,"column":1}},"key":"AoQ7k0fVQN"},{"type":"paragraph","position":{"start":{"line":263,"column":1},"end":{"line":263,"column":1}},"children":[{"type":"text","value":"This will give us the following output.","position":{"start":{"line":263,"column":1},"end":{"line":263,"column":1}},"key":"KFnBbDXeiU"}],"key":"sgx6rp5fhZ"},{"type":"code","lang":"","value":"\n               [['en', 'it', 'fi', 'fr', 'de', 'zh-hans', 'ru', 'hu', 'he', 'nl', 'pt', 'pl', 'ca', 'cs', 'ilo', 'zh', 'nb', 'ko',..        \n","position":{"start":{"line":265,"column":1},"end":{"line":269,"column":1}},"key":"o9ZCPZhDyy"},{"type":"paragraph","position":{"start":{"line":272,"column":1},"end":{"line":273,"column":1}},"children":[{"type":"text","value":"Now we calculate the frequent itemsets using ","position":{"start":{"line":272,"column":1},"end":{"line":272,"column":1}},"key":"rLOwqDZSWv"},{"type":"emphasis","position":{"start":{"line":272,"column":1},"end":{"line":272,"column":1}},"children":[{"type":"text","value":"apriori","position":{"start":{"line":272,"column":1},"end":{"line":272,"column":1}},"key":"Uye3XRM8cE"}],"key":"ijL3VPLZ5c"},{"type":"text","value":" algorithm. Please\nuncomment the print statement to see the intermediate dataframe.","position":{"start":{"line":272,"column":1},"end":{"